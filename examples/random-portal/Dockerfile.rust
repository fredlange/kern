# The same app on the Rust toolchain (docs/research/RUST_PORT_PLAN.md). It takes the `kern` binary from the
# repository's own image instead of copying its build recipe. From the repository root:
#   docker build --target kern -t kern .
#   docker build -f examples/random-portal/Dockerfile.rust -t random-portal:rust .
ARG KERN_IMAGE=kern
FROM ${KERN_IMAGE} AS kern

FROM node:22-alpine AS web
WORKDIR /web
COPY examples/random-portal/web/package.json examples/random-portal/web/package-lock.json ./
RUN npm ci
COPY examples/random-portal/web/ ./
RUN npm run build

# trixie, like the kern image, so the binary's glibc matches. HTTPS replies use rustls with
# bundled roots (ureq `tls`), so no CA package is needed for the host.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends nginx curl \
 && rm -rf /var/lib/apt/lists/* && rm -f /etc/nginx/sites-enabled/default
COPY --from=kern /usr/local/bin/kern /usr/local/bin/kern
WORKDIR /app
COPY examples/random-portal/portal.k examples/random-portal/portal.host examples/random-portal/portal.why ./
COPY --from=web /web/dist/ /srv/www/
# `check` exits 1 unless every definition is clean, so an unproven module fails the build.
RUN kern check portal.k --why portal.why --html /srv/www/proof.html --cache '' \
 && kern host page portal.k --html /srv/www/host.html
COPY examples/random-portal/nginx.conf /etc/nginx/conf.d/portal.conf
COPY examples/random-portal/entrypoint.sh /entrypoint.sh
ENV KERN_HOST="kern host"
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s CMD curl -sf http://127.0.0.1:8000/api/state >/dev/null
CMD ["/entrypoint.sh"]
